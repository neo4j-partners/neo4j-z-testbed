# Settings for laptop-test.py and gds-test.py. Copy this file to vm/.env and
# set the values.
# Variables already set in your shell take precedence over this file.
# Use single quotes around any value with special characters.

# Address of the server.
SERVER_IP=<server-ip>

# Password for the neo4j user. If this is not set, the script prompts for it.
NEO4J_PW='<your-password>'

# Local port for the tunnel. The cluster also uses this port + 10 and + 20.
# LOCAL_BOLT_PORT=17687

# SSH password or SSH key passphrase. If this is not set, ssh prompts as usual.
# SSH_PW='<ssh-password>'
