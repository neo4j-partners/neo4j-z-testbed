# Settings for laptop-test.py and gds-test.py. Copy this file to tests/.env and
# set the values.
# Variables already set in your shell take precedence over this file.
# Use single quotes around any value with special characters.

# Password for the neo4j user. If this is not set, the script prompts for it.
NEO4J_PW='<your-password>'

# Local port for Bolt. Each further cluster member uses 10 more than the last.
# LOCAL_BOLT_PORT=17687

# --via ssh: address of the server.
SERVER_IP=<server-ip>

# --via ssh: SSH password or SSH key passphrase. If this is not set, ssh prompts
# as usual.
# SSH_PW='<ssh-password>'

# --via oc: namespace and label selector of the Neo4j pods.
# OC_NAMESPACE=<namespace>
# OC_POD_SELECTOR=<label>=<value>
